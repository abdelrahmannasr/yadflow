      "Bash(yad signing check:*)",
      "Bash(yad ci check:*)",
      "Bash(yad toolbox list:*)",
      "Bash(yad toolbox check:*)",
      "Bash(yad local-setup list:*)",
      "Bash(yad skill list:*)",
      "Bash(yad skill recommend:*)",
      "Bash(yad foundation status:*)",
      "Bash(yad status:*)",
      "Bash(yad next:*)",
      "Bash(yad gate status:*)",
      "Bash(yad gate review:*)",
      "Bash(yad gate walkthrough:*)",
      "Bash(yad review context:*)",

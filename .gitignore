# OS
.DS_Store

# BMAD install (regenerable via `npx bmad-method install`)
_bmad/
_bmad-output/

# IDE skill mirrors (regenerable via `yad check --fix`)
# .claude/ holds per-machine skill mirrors; only the shared settings.json (yad's agent-guard hook) is tracked.
# `!/.claude/` first: a global ignore rule of `.claude/` hides the whole folder, and git cannot bring back a
# file inside an ignored folder.
!/.claude/
.claude/*
!.claude/settings.json
.agents/
.cursor/
.gemini/
.opencode/
.zencoder/

# Throwaway demo code repos (Phase 3). Each demo-repos/<repo>/ is its OWN git repo
# modeling a real separate code repo — never tracked by (or a submodule of) this repository.
# The explainer demo-repos/README.md IS tracked (negation below).
demo-repos/*/
!demo-repos/README.md

# A Repomix pack (yad-connect-repos) is a large, regenerable cache. This repository is no longer a Product
# (2026-11-16) and tracks no .sdlc/code-context/, but an old checkout may still hold packs there.
.sdlc/code-context/*/pack.md

# Learning layer (yad-learn) — personal, LOCAL-ONLY output. Never commit or push the records ledger or
# the rendered tutorials, in this repo or any product. The connection registry .sdlc/learning.json
# (no secrets, no personal data) IS tracked — it is the only committed learning file.
.sdlc/learning-records.json
.sdlc/learning/
epics/*/.sdlc/learning-records.json
epics/*/learning/

# Empty/generated scaffolding
design-artifacts/
skills/reports/

# Interactive doc sites (yad-docs / yad-docs-overview) — the generated SOURCE is committed; only the
# build output and installed deps are ignored. The skill template under skills/yad-docs/templates/
# ships no node_modules/dist, so it is unaffected.
epics/*/docs-site/node_modules/
epics/*/docs-site/dist/
docs/sdlc-site/node_modules/
docs/sdlc-site/dist/

# Node
node_modules/

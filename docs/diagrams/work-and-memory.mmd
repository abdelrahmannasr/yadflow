%% Intro diagram 1 — how everyday work and the project record feed each other.
%% Conceptual: not every arrow is automatic. Regenerate with `npm run diagrams`.
flowchart TD
    classDef knowledge fill:#fcf3cf,stroke:#b7950b,color:#000
    classDef work fill:#d6eaf8,stroke:#2471a3,color:#000
    classDef review fill:#fdebd0,stroke:#ca6f1e,color:#000

    rec[("Project record<br/>plans · decisions · contracts<br/>reviews · history")]:::knowledge
    ctx["People and AI assistants<br/>read the context"]:::work
    plan["Plan the change"]:::work
    rev{{"Human review<br/>approve or comment"}}:::review
    build["Build it in the code repos"]:::work
    chk{{"Checks and code review"}}:::review
    out["Record the outcome<br/>ship log · follow-up changes"]:::knowledge

    rec --> ctx --> plan --> rev
    rev -->|approved| build --> chk
    rev -.->|changes asked| plan
    chk -->|merged| out
    out -->|next task starts here| rec

    linkStyle default stroke:#8a8a8a,stroke-width:2px
